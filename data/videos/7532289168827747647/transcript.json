{
  "video_id": "7532289168827747647",
  "language": "zh",
  "duration": 115.8,
  "segments": [
    {
      "start": 0.14,
      "end": 3.4,
      "text": "一分钟后你将拥有无限复制爆款视频的能力"
    },
    {
      "start": 3.4,
      "end": 5.94,
      "text": "很多人关注我是因为想学会做短视频"
    },
    {
      "start": 5.94,
      "end": 6.94,
      "text": "但是拍什么"
    },
    {
      "start": 6.94,
      "end": 8.2,
      "text": "怎么拍才有流量"
    },
    {
      "start": 8.2,
      "end": 10.6,
      "text": "除了抄袭还有没有更好的办法"
    },
    {
      "start": 10.6,
      "end": 12.56,
      "text": "朋友们请你看清一件事"
    },
    {
      "start": 12.56,
      "end": 13.96,
      "text": "做爆款不要憋灵感"
    },
    {
      "start": 13.96,
      "end": 14.98,
      "text": "更不能抄袭"
    },
    {
      "start": 14.98,
      "end": 16.46,
      "text": "而是套用爆款的结构"
    },
    {
      "start": 16.46,
      "end": 18.52,
      "text": "下面我就用这把手术刀"
    },
    {
      "start": 18.52,
      "end": 20.7,
      "text": "让你掌握这种爆款课能数"
    },
    {
      "start": 20.7,
      "end": 22.34,
      "text": "如果你已经是个写作高手"
    },
    {
      "start": 22.34,
      "end": 23.46,
      "text": "可以忽略这条视频"
    },
    {
      "start": 23.46,
      "end": 25.5,
      "text": "那么咱们现在开始下刀"
    },
    {
      "start": 25.5,
      "end": 28.0,
      "text": "第一刀锁定猎物取内脏"
    },
    {
      "start": 28.0,
      "end": 30.3,
      "text": "从收藏夹或者你的点赞列表里"
    },
    {
      "start": 30.3,
      "end": 32.28,
      "text": "找到那条想要学习渐渐的爆款视频"
    },
    {
      "start": 32.28,
      "end": 34.34,
      "text": "接下来它就是你的克隆样本"
    },
    {
      "start": 34.34,
      "end": 35.34,
      "text": "把视频链接"
    },
    {
      "start": 35.34,
      "end": 37.42,
      "text": "粘贴到豆包电脑版的对话框里"
    },
    {
      "start": 37.42,
      "end": 38.38,
      "text": "让它提取文案"
    },
    {
      "start": 38.38,
      "end": 41.54,
      "text": "咱们先拿到一篇完整的爆款文案"
    },
    {
      "start": 41.54,
      "end": 43.44,
      "text": "第二刀猜出爆款的谷歌"
    },
    {
      "start": 43.44,
      "end": 45.24,
      "text": "直接抄袭肯定是不行的"
    },
    {
      "start": 45.24,
      "end": 48.18,
      "text": "现在要做的是得到这条爆款文案的结构"
    },
    {
      "start": 48.18,
      "end": 51.04,
      "text": "豆包电脑版本身就有AI视频分析的功能"
    },
    {
      "start": 51.04,
      "end": 53.28,
      "text": "只要在对话框里加入一句咒语"
    },
    {
      "start": 53.28,
      "end": 55.04,
      "text": "把上面的文案分出段落"
    },
    {
      "start": 55.04,
      "end": 57.98,
      "text": "总结核心结构和情绪转折点"
    },
    {
      "start": 57.98,
      "end": 59.58,
      "text": "并提炼出钩子话术"
    },
    {
      "start": 59.58,
      "end": 60.54,
      "text": "这句话很关键"
    },
    {
      "start": 60.54,
      "end": 61.22,
      "text": "一定要记好"
    },
    {
      "start": 61.22,
      "end": 62.18,
      "text": "等待一下"
    },
    {
      "start": 62.18,
      "end": 63.28,
      "text": "好"
    },
    {
      "start": 63.28,
      "end": 65.18,
      "text": "经过它的分析和总结"
    },
    {
      "start": 65.18,
      "end": 66.64,
      "text": "现在你能清楚地看到"
    },
    {
      "start": 66.64,
      "end": 68.26,
      "text": "原文的写作逻辑是什么"
    },
    {
      "start": 68.26,
      "end": 68.9,
      "text": "钩子在哪"
    },
    {
      "start": 68.9,
      "end": 69.78,
      "text": "痛点在哪"
    },
    {
      "start": 69.78,
      "end": 70.54,
      "text": "第三刀"
    },
    {
      "start": 70.54,
      "end": 71.8,
      "text": "换上你的血肉"
    },
    {
      "start": 71.8,
      "end": 73.9,
      "text": "虽然AI有帮我写作的功能"
    },
    {
      "start": 73.9,
      "end": 76.1,
      "text": "用过AI写作的朋友应该都有体会"
    },
    {
      "start": 76.1,
      "end": 77.6,
      "text": "人工智能写出来的脚本"
    },
    {
      "start": 77.6,
      "end": 78.56,
      "text": "虽然又快又准"
    },
    {
      "start": 78.56,
      "end": 80.52,
      "text": "但是总有点像缝合怪"
    },
    {
      "start": 80.52,
      "end": 82.24,
      "text": "既然有了爆款文案的股价"
    },
    {
      "start": 82.24,
      "end": 83.98,
      "text": "接下来换成你的选题"
    },
    {
      "start": 83.98,
      "end": 85.82,
      "text": "直接按照爆款的脚本结构"
    },
    {
      "start": 85.82,
      "end": 86.82,
      "text": "贴写式的脚本"
    },
    {
      "start": 86.82,
      "end": 87.52,
      "text": "写完之后"
    },
    {
      "start": 87.52,
      "end": 89.76,
      "text": "一篇符合爆款框架的脚本书稿"
    },
    {
      "start": 89.76,
      "end": 90.48,
      "text": "就完成了"
    },
    {
      "start": 90.48,
      "end": 91.52,
      "text": "最后一刀"
    },
    {
      "start": 91.52,
      "end": 92.96,
      "text": "注入你的灵魂"
    },
    {
      "start": 92.96,
      "end": 95.76,
      "text": "用写作模板里的润色和调整语气"
    },
    {
      "start": 95.76,
      "end": 98.16,
      "text": "根据你本人平时的语言特点"
    },
    {
      "start": 98.16,
      "end": 99.36,
      "text": "选择语言风格"
    },
    {
      "start": 99.36,
      "end": 101.76,
      "text": "然后再告诉他一些你的口头禅"
    },
    {
      "start": 101.76,
      "end": 102.84,
      "text": "或者是你的方言"
    },
    {
      "start": 102.84,
      "end": 105.18,
      "text": "调整完就是你的一篇超级原创"
    },
    {
      "start": 105.18,
      "end": 106.42,
      "text": "拆解优秀的作品"
    },
    {
      "start": 106.42,
      "end": 108.76,
      "text": "一直是短视频编导的制学手段"
    },
    {
      "start": 108.76,
      "end": 109.88,
      "text": "只不过有了AI"
    },
    {
      "start": 109.88,
      "end": 110.86,
      "text": "效率变得更快"
    },
    {
      "start": 110.86,
      "end": 112.82,
      "text": "朋友们学会给我去拍吧"
    },
    {
      "start": 112.82,
      "end": 113.78,
      "text": "希望这条视频"
    },
    {
      "start": 113.78,
      "end": 115.68,
      "text": "能够帮你刷新人生的脚本"
    },
    {
      "start": 115.68,
      "end": 145.66,
      "text": "感谢观看"
    }
  ],
