    {
      "start": 112.92,
      "end": 115.34,
      "text": "但是用它一两分钟就出活了"
    },
    {
      "start": 115.34,
      "end": 116.74,
      "text": "接着我又跟它聊了几轮"
    },
    {
      "start": 116.74,
      "end": 118.74,
      "text": "把我的界面和功能都打磨了一下"
