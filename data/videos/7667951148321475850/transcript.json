  "duration": 324.0,
  "segments": [
    {
      "start": 0.0,
      "end": 1.76,
      "text": "全大学人手一个联盟技能"
    },
    {
      "start": 1.76,
      "end": 5.13,
      "text": "一千名是胜利阵营瓜分"
    },
    {
      "start": 5.13,
      "end": 10.18,
      "text": "老师一人打十个"
    },
    {
      "start": 10.18,
      "end": 11.54,
      "text": "你打我夜问啊"
    },
    {
      "start": 11.54,
      "end": 13.44,
      "text": "老师们开局自选一件装备"
    },
    {
      "start": 13.44,
      "end": 15.88,
      "text": "并且拥有英雄的全胜姿态"
    },
    {
      "start": 15.88,
      "end": 20.42,
      "text": "这把我直接偷塔"
    },
    {
      "start": 20.42,
      "end": 23.1,
      "text": "准备好进入火焰世界了吗"
    },
    {
      "start": 23.1,
      "end": 26.32,
      "text": "有什么话和我的明火说去吧"
    },
    {
      "start": 26.32,
      "end": 30.71,
      "text": "这就淘汰了"
    },
    {
      "start": 30.71,
      "end": 32.19,
      "text": "老师也太超伯了"
    },
    {
      "start": 32.19,
      "end": 33.83,
      "text": "他98年的老召唤师"
    },
    {
      "start": 33.83,
      "end": 35.29,
      "text": "我们玩不过他"
    },
    {
      "start": 35.29,
      "end": 37.95,
      "text": "那么在天音波滑行的途中"
    },
    {
      "start": 37.95,
      "end": 39.15,
      "text": "接人龙摆尾"
    },
    {
      "start": 39.15,
      "end": 45.48,
      "text": "老师脑够了没"
    },
    {
      "start": 45.48,
      "end": 53.39,
      "text": "李老师"
    },
    {
      "start": 53.39,
      "end": 55.09,
      "text": "你个奶妈哪来的自信"
    },
    {
      "start": 55.09,
      "end": 62.57,
      "text": "阿玛特拉斯"
    },
    {
      "start": 62.57,
      "end": 63.67,
      "text": "还有老赛恩"
    },
    {
      "start": 63.67,
      "end": 67.33,
      "text": "找个角落美美隐身"
    },
    {
      "start": 67.33,
      "end": 80.36,
      "text": "精怪魔法"
    },
    {
      "start": 80.36,
      "end": 81.56,
      "text": "这把爽局"
    },
    {
      "start": 81.56,
      "end": 92.14,
      "text": "升级献气加日眼斗篷"
    },
    {
      "start": 92.14,
      "end": 93.16,
      "text": "武魂柔和气"
    },
    {
      "start": 93.16,
      "end": 94.88,
      "text": "你们都起飞了"
    },
    {
      "start": 94.88,
      "end": 97.16,
      "text": "为什么我的技能是大胃带撞人"
    },
    {
      "start": 97.16,
      "end": 100.02,
      "text": "怎么突然这么热"
    },
    {
      "start": 100.02,
      "end": 104.38,
      "text": "我去"
    },
    {
      "start": 104.38,
      "end": 105.78,
      "text": "又不干净的东西"
    },
    {
      "start": 105.78,
      "end": 109.06,
      "text": "领域展开"
    },
    {
      "start": 109.06,
      "end": 109.82,
      "text": "单挑吧"
    },
    {
      "start": 109.82,
      "end": 111.0,
      "text": "就你和我"
    },
    {
      "start": 111.0,
      "end": 114.73,
      "text": "单挑嘛"
    },
    {
      "start": 114.73,
      "end": 115.69,
      "text": "有点意思"
    },
    {
      "start": 115.69,
      "end": 125.38,
      "text": "一百层坦克引擎万层心之缸"
    },
    {
      "start": 125.38,
      "end": 126.62,
      "text": "还有谁"
    },
    {
      "start": 126.62,
      "end": 127.36,
      "text": "我去"
    },
    {
      "start": 127.36,
      "end": 129.18,
      "text": "是钢分老鼓蒙多大人"
    },
    {
      "start": 129.18,
      "end": 130.74,
      "text": "无所谓"
    },
    {
      "start": 130.74,
      "end": 132.12,
      "text": "我会出手"
    },
    {
      "start": 132.12,
      "end": 156.95,
      "text": "按计划发起反攻"
    },
    {
      "start": 156.95,
      "end": 157.73,
      "text": "放心吧"
    },
    {
      "start": 157.73,
      "end": 158.79,
      "text": "还没有问题"
    },
    {
      "start": 158.79,
      "end": 181.18,
      "text": "传说中的落地精深"
    },
    {
      "start": 181.18,
      "end": 193.7,
      "text": "无妨"
    },
    {
      "start": 193.7,
      "end": 196.36,
      "text": "我将恢复树锐马的荣光"
    },
    {
      "start": 196.36,
      "end": 198.66,
      "text": "杀爆送葬"
    },
    {
      "start": 198.66,
      "end": 229.72,
      "text": "你别攻击队友啊"
    },
    {
      "start": 229.72,
      "end": 230.28,
      "text": "义父"
    },
    {
      "start": 230.28,
      "end": 231.26,
      "text": "快发一把"
    },
    {
      "start": 231.26,
      "end": 233.22,
      "text": "别急"
    },
    {
      "start": 233.22,
      "end": 234.2,
      "text": "做完你的"
    },
    {
      "start": 234.2,
      "end": 235.58,
      "text": "再做你的"
    },
    {
      "start": 235.58,
      "end": 270.17,
      "text": "不知道我能不能顶得住"
    },
    {
      "start": 270.17,
      "end": 271.49,
      "text": "你只是个青铜三"
    },
    {
      "start": 271.49,
      "end": 272.47,
      "text": "拿什么顶"
    },
    {
      "start": 272.47,
      "end": 275.4,
      "text": "夹这个"
    },
    {
      "start": 275.4,
      "end": 276.02,
      "text": "能不能顶"
    },
    {
      "start": 276.02,
      "end": 315.34,
      "text": "谭剑来"
    },
    {
      "start": 315.34,
      "end": 316.44,
      "text": "死门为大爷"
    },
    {
      "start": 316.44,
      "end": 318.16,
      "text": "锐天爹"
    },
    {
      "start": 318.16,
      "end": 320.82,
      "text": "优优独播剧场——YoYo Television Series Exclusive"
    }
  ],
